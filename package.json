{
	"name": "ran-enhanced-cover",
	"version": "1.3.1",
	"private": true,
	"description": "Standalone motion-sensitive enhanced Cover block for WordPress.",
	"author": "bnjmnrsh",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"wordpress",
		"blocks",
		"gutenberg",
		"video",
		"cover",
		"accessibility"
	],
	"homepage": "https://github.com/RocketsAreNostalgic/ran-enhanced-cover",
	"repository": {
		"type": "git",
		"url": "https://github.com/RocketsAreNostalgic/ran-enhanced-cover.git"
	},
	"bugs": {
		"url": "https://github.com/RocketsAreNostalgic/ran-enhanced-cover"
	},
	"engines": {
		"node": ">=24.11.0 <25"
	},
	"devDependencies": {
		"@babel/core": "7.29.7",
		"@playwright/test": "^1.61.1",
		"@rocketsarenostalgic/quality-config": "github:RocketsAreNostalgic/ran-quality-config#751edd097e3902efb93992bf47401a1a4f4b1fa8",
		"@wordpress/env": "^11.10.0",
		"@wordpress/eslint-plugin": "25.7.0",
		"@wordpress/prettier-config": "4.51.0",
		"@wordpress/scripts": "^30.25.0",
		"@wordpress/stylelint-config": "24.0.0",
		"eslint": "9.39.5",
		"prettier": "3.9.5",
		"react": "18.3.1",
		"react-dom": "18.3.1",
		"stylelint": "16.26.1",
		"stylelint-scss": "6.14.0",
		"typescript": "6.0.3"
	},
	"scripts": {
		"hooks:install": "git config core.hooksPath .githooks",
		"prepare": "git config core.hooksPath .githooks",
		"start": "wp-scripts start --source-path=blocks --output-path=build/blocks",
		"build": "wp-scripts build --source-path=blocks --output-path=build/blocks",
		"format": "prettier --write --ignore-path .prettierignore --ignore-unknown .",
		"format:check": "prettier --check --ignore-path .prettierignore --ignore-unknown .",
		"lint:js": "eslint \"blocks/**/*.js\" webpack.config.js \"tests/browser/**/*.js\"",
		"lint:css": "stylelint \"blocks/**/*.css\"",
		"lint:pkg-json": "wp-scripts lint-pkg-json",
		"lint:php": "bash scripts/lint-php.sh",
		"pot": "wp i18n make-pot . languages/ran-enhanced-cover.pot --exclude=build,node_modules,vendor,tests,dist,wordpress-org && php scripts/prepare-pot-for-release.php",
		"i18n:pot": "pnpm pot",
		"check": "pnpm lint:pkg-json && pnpm lint:js && pnpm lint:css && pnpm format:check",
		"check:generated": "pnpm build && pnpm i18n:pot && git diff --exit-code -- build/blocks languages/ran-enhanced-cover.pot",
		"check:build": "pnpm check:generated",
		"test:php": "composer test",
		"release": "php scripts/build-release.php",
		"release:verify": "php scripts/verify-release.php",
		"release:plugin-check": "bash scripts/plugin-check.sh",
		"test:browser": "playwright test --config=tests/browser/playwright.config.js"
	},
	"volta": {
		"node": "24.11.0"
	},
	"packageManager": "pnpm@11.5.2"
}
