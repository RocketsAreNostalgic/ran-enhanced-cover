<?xml version="1.0"?>
<ruleset name="RAN Video Cover">
	<description>RAN WordPress plugin standards with repository-local support and identity policy.</description>

	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<arg name="extensions" value="php"/>
	<arg value="ps"/>

	<!-- Repository support policy remains local. -->
	<config name="minimum_wp_version" value="6.5"/>
	<config name="testVersion" value="8.0-"/>

	<file>ran-enhanced-cover.php</file>
	<file>includes</file>
	<file>blocks</file>
	<file>scripts</file>
	<file>tests</file>

	<exclude-pattern>*/build/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<!-- CLI packaging and one-off migration tools are linted, not WordPress-runtime code. -->
	<exclude-pattern>*/scripts/*</exclude-pattern>
	<exclude-pattern>*/blocks/media/video-cover/*.asset.php</exclude-pattern>

	<!-- Shared RAN WordPress/WPCS/PHPCompatibility ancestry. -->
	<rule ref="RANWordPressPlugin"/>

	<!-- Repository identity remains local. -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="ran-enhanced-cover"/>
			</property>
		</properties>
	</rule>

	<!-- This legacy/runtime filename is dictated by WordPress metadata. -->
	<rule ref="WordPress.Files.FileName.NotHyphenatedLowercase">
		<exclude-pattern>*/includes/Blocks.php</exclude-pattern>
	</rule>
	<rule ref="WordPress.Files.FileName.InvalidClassFileName">
		<exclude-pattern>*/includes/Blocks.php</exclude-pattern>
	</rule>
</ruleset>
